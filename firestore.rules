rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasDbRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    function isAdmin() {
      return hasDbRole('admin') || hasDbRole('superadmin');
    }

    function isCounterOperator() {
      return isAdmin() || hasDbRole('counter_operator');
    }

    function isGateStaff() {
      return isAdmin() || hasDbRole('gate_staff');
    }

    // ============================================================
    // 1. USERS
    // ============================================================
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      allow delete: if isAdmin();
    }

    // ============================================================
    // 2. EVENTS (public read for user app, admin write)
    // ============================================================
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || !isSignedIn();

      match /ticketTypes/{typeId} {
        allow read: if true;
        allow write: if isAdmin() || !isSignedIn();
      }
    }

    // ============================================================
    // 3. BANNERS
    // ============================================================
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin() || !isSignedIn();
    }

    // ============================================================
    // 4. TICKET TIERS (root-level)
    // ============================================================
    match /ticketTiers/{tierId} {
      allow read: if true;
      allow write: if isAdmin() || !isSignedIn();
    }

    // ============================================================
    // 4b. TICKET TYPES (root-level collection used by ADMIN)
    // ============================================================
    match /ticketTypes/{typeId} {
      allow read: if true;
      allow write: if true;
    }

    // ============================================================
    // 5. BOOKINGS (public read/write for dev — restrict in production)
    // ============================================================
    match /bookings/{bookingId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    // ============================================================
    // 6. TICKETS
    // ============================================================
    match /tickets/{ticketId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin() || !isSignedIn();
    }

    // ============================================================
    // 7. SEATS
    // ============================================================
    match /seats/{eventId}/{blockId}/{rowId}/{seatNumber} {
      allow read: if true;
      allow write: if isSignedIn() || !isSignedIn();
    }

    // ============================================================
    // 8. COUNTERS (public read/write for dev)
    // ============================================================
    match /counters/{counterId} {
      allow read: if true;
      allow write: if true;
    }

    // ============================================================
    // 9. GATES (public read/write for dev)
    // ============================================================
    match /gates/{gateId} {
      allow read: if true;
      allow write: if true;
    }

    // ============================================================
    // 10. SUPPORT TICKETS
    // ============================================================
    match /supportTickets/{ticketId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ============================================================
    // 11. SETTINGS
    // ============================================================
    match /settings/{docId} {
      allow read: if isSignedIn() || !isSignedIn();
      allow write: if isAdmin() || !isSignedIn();
    }

    // ============================================================
    // 12. AUDIT LOGS
    // ============================================================
    match /logs/{logId} {
      allow create: if isSignedIn() || !isSignedIn();
      allow read: if isAdmin() || !isSignedIn();
      allow update, delete: if false;
    }
  }
}
