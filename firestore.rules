rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // HELPER FUNCTIONS
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasDbRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    function isAdmin() {
      return hasDbRole('admin') || hasDbRole('superadmin');
    }

    function isCounterOperator() {
      return isAdmin() || hasDbRole('counter_operator');
    }

    function isGateStaff() {
      return isAdmin() || hasDbRole('gate_staff');
    }

    // ============================================================
    // 1. USERS
    // ============================================================
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      allow delete: if isAdmin();
    }

    // ============================================================
    // 2. EVENTS
    // ============================================================
    match /events/{eventId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /ticketTypes/{typeId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // ============================================================
    // 3. BANNERS
    // ============================================================
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================
    // 3. TICKET TIERS
    // ============================================================
    match /ticketTiers/{tierId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================================================
    // 4. BOOKINGS
    // ============================================================
    match /bookings/{bookingId} {
      allow read: if isAdmin() || isCounterOperator() || isGateStaff()
                  || (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isCounterOperator() || isAdmin();

      allow update: if isGateStaff()
                    && resource.data.status == 'Confirmed'
                    && request.resource.data.status == 'Checked-in'
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'checkedInAt', 'checkedInGate', 'scannedBy']);

      allow update: if isAdmin();
      allow delete: if false;
    }

    // ============================================================
    // 5. TICKETS
    // ============================================================
    match /tickets/{ticketId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // ============================================================
    // 6. SEATS
    // ============================================================
    match /seats/{eventId}/{blockId}/{rowId}/{seatNumber} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // ============================================================
    // 7. COUNTERS
    // ============================================================
    match /counters/{counterId} {
      allow read: if isAdmin() || isCounterOperator();
      allow update: if isCounterOperator() && request.auth.uid == resource.data.operatorUid;
      allow create, delete: if isAdmin();
    }

    // ============================================================
    // 8. GATES
    // ============================================================
    match /gates/{gateId} {
      allow read: if isSignedIn();
      allow update: if isGateStaff()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['entered', 'status', 'percentage']);
      allow create, delete: if isAdmin();
    }

    // ============================================================
    // 9. SUPPORT TICKETS
    // ============================================================
    match /supportTickets/{ticketId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ============================================================
    // 10. SETTINGS
    // ============================================================
    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ============================================================
    // 11. AUDIT LOGS
    // ============================================================
    match /logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
