# JATRA BAZAAR — Environment Variables Template

# App
NEXT_PUBLIC_APP_NAME="JATRA BAZAAR"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_your_key"
SUPABASE_SERVICE_ROLE_KEY=""

# Firebase
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_DATABASE_URL=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Fast2SMS Gateway (Server-side SMS & OTP)
FAST2SMS_API_KEY=""

# Google OAuth
GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─────────────────────────────────────────────────────────────────────────────
# Paytm Payment Gateway Configuration
# ─────────────────────────────────────────────────────────────────────────────
# KEEP ALL MERCHANT KEYS SERVER-SIDE ONLY. NEVER PREFIX WITH NEXT_PUBLIC_.
#
# 1. STAGING / TEST MODE (Active by default):
PAYTM_ENVIRONMENT=STAGE
PAYTM_MID=DIY1234567890123456
PAYTM_MERCHANT_KEY=1234567890123456
PAYTM_WEBSITE=WEBSTAGING
PAYTM_CHANNEL_ID=WEB
PAYTM_INDUSTRY_TYPE_ID=Retail

# 2. TO SWITCH TO LIVE / PRODUCTION MODE (Only when authorized):
# Change the following values in your production server environment:
# PAYTM_ENVIRONMENT=PROD
# PAYTM_MID=<YOUR_PRODUCTION_MERCHANT_ID>
# PAYTM_MERCHANT_KEY=<YOUR_16_CHAR_PRODUCTION_KEY>
# PAYTM_WEBSITE=DEFAULT
# NEXT_PUBLIC_APP_URL=https://your-production-domain.com
